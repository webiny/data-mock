    "lint": "oxlint --deny-warnings src/",
    "lint:check": "oxlint --deny-warnings src/",
    "lint:fix": "oxlint --fix --deny-warnings src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "format:fix": "oxfmt src/",
    "cli": "tsx src/cli/entry.ts",
    "api:dev": "tsx --watch src/api/entry.ts",
