# webiny-mock-data configuration
# Copy to .env and fill in values, or run: yarn cli init

# Encryption key for API tokens stored in SQLite (do NOT share or commit)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Server ports
API_PORT=4000
UI_PORT=4001

# Database path (default: .webiny/data-mock.db)
# DB_PATH=.webiny/data-mock.db
